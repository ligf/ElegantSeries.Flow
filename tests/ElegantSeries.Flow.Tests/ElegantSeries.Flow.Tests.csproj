<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- xUnit1051 (pass TestContext.Current.CancellationToken) is intentionally suppressed:
         navigation calls in these tests are synchronous-in-effect and complete immediately;
         cooperative cancellation is covered by dedicated cancellation tests instead. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\GeneratedLayerReservation.cs" Link="Shared\GeneratedLayerReservation.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ElegantSeries.Flow\ElegantSeries.Flow.csproj" />
    <!-- Referenced so GeneratedNamespaceGuardTests can inspect the library
         assemblies' metadata; the tests themselves exercise Core only. The
         WPF package (net10.0-windows) cannot be referenced from net10.0 —
         its guard lives in the WPF test project's windows leg instead. -->
    <ProjectReference Include="..\..\src\ElegantSeries.Flow.Mvvm\ElegantSeries.Flow.Mvvm.csproj" />
    <ProjectReference Include="..\..\src\ElegantSeries.Flow.Avalonia\ElegantSeries.Flow.Avalonia.csproj" />
    <ProjectReference Include="..\..\src\ElegantSeries.Flow.Generator\ElegantSeries.Flow.Generator.csproj" />
    <ProjectReference Include="..\..\src\ElegantSeries.Flow.Diagnostics\ElegantSeries.Flow.Diagnostics.csproj" />
    <ProjectReference Include="..\..\src\ElegantSeries.Flow.Routing\ElegantSeries.Flow.Routing.csproj" />
    <ProjectReference Include="..\..\src\ElegantSeries.Flow.Journal\ElegantSeries.Flow.Journal.csproj" />
  </ItemGroup>

</Project>