<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone WPF NuGet consumer for the packaging verification
    harness (see ../README.md). Deliberately NOT part of
    ElegantSeries.Flow.slnx: it must restore the published packages
    from a feed, never the projects. FlowVersion is supplied by
    ../verify.sh (the version of the packages it just packed); a
    manual build must pass it too:
      dotnet build -p:FlowVersion=1.0.0-rc.2
    EnableWindowsTargeting lets the project restore and build on
    non-Windows machines (a compile-only packaging check there);
    running it requires Windows.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ElegantSeries.Flow" Version="$(FlowVersion)" />
    <PackageReference Include="ElegantSeries.Flow.WPF" Version="$(FlowVersion)" />
  </ItemGroup>

</Project>
