<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone NuGet consumer for the packaging verification harness
    (see ../README.md). Deliberately NOT part of ElegantSeries.Flow.slnx:
    it must restore the published packages from a feed, never the
    projects. FlowVersion is supplied by ../verify.sh (the version of
    the packages it just packed); a manual build must pass it too:
      dotnet run -p:FlowVersion=1.0.0-rc.2
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ElegantSeries.Flow" Version="$(FlowVersion)" />
    <PackageReference Include="ElegantSeries.Flow.Avalonia" Version="$(FlowVersion)" />
    <PackageReference Include="ElegantSeries.Flow.Mvvm" Version="$(FlowVersion)" />
    <PackageReference Include="ElegantSeries.Flow.Diagnostics" Version="$(FlowVersion)" />
    <PackageReference Include="ElegantSeries.Flow.Routing" Version="$(FlowVersion)" />
  </ItemGroup>

</Project>
