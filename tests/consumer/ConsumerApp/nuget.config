<?xml version="1.0" encoding="utf-8"?>
<!-- The consumer restores ElegantSeries.Flow packages ONLY from the
     local feed produced by ../verify.sh (../feed), never from
     nuget.org — that is what makes this a packaging test. Everything
     else (Avalonia, Microsoft.Extensions.DependencyInjection, ...)
     comes from nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="local-pack-output" value="../feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-pack-output">
      <package pattern="ElegantSeries.Flow*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
