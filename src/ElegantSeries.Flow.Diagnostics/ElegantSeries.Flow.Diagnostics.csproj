<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- NuGet package metadata -->
    <Authors>ligf</Authors>
    <Description>Diagnostics for ElegantSeries.Flow: a System.Diagnostics.Metrics observer that turns navigation events into counters (navigations completed, view models released, cache clears, subscriber errors) on the ElegantSeries.Flow.Diagnostics meter.</Description>
    <PackageTags>navigation;diagnostics;metrics;opentelemetry;aot;trimming</PackageTags>
    <PackageProjectUrl>https://github.com/ligf/ElegantSeries.Flow</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ligf/ElegantSeries.Flow</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Documentation and symbols -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <!-- NU1902: known moderate vulnerability in Microsoft.Build.Tasks.Git, a build-time-only
         SourceLink dependency (PrivateAssets=All); it never ships to package consumers. -->
    <NoWarn>$(NoWarn);NU1902;RS0026</NoWarn>
    <ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)' == ''">false</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ElegantSeries.Flow\ElegantSeries.Flow.csproj" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
    <!-- Public API baseline: RS0016/RS0017 guard the declared surface in
         PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt (build-time only). -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
