<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- NuGet package metadata -->
    <PackageId>ElegantSeries.Flow</PackageId>
    <Version>0.1.1</Version>
    <Authors>ligf</Authors>
    <Description>A lightweight, AOT-friendly MVVM navigation library for .NET: region-based navigation stacks, KeepAlive ViewModel caching, typed navigation parameters, navigation guards, and lifecycle callbacks.</Description>
    <PackageTags>navigation;mvvm;viewmodel;aot;trimming</PackageTags>
    <PackageProjectUrl>https://github.com/ligf/ElegantSeries.Flow</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ligf/ElegantSeries.Flow</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Documentation and symbols -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <!-- NU1902: known moderate vulnerability in Microsoft.Build.Tasks.Git, a build-time-only
         SourceLink dependency (PrivateAssets=All); it never ships to package consumers. -->
    <NoWarn>$(NoWarn);NU1902</NoWarn>
    <ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)' == ''">false</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- [ViewFor] source generator: embedded into this package as a Roslyn analyzer
         (CommunityToolkit.Mvvm pattern), so consumers get it automatically with no
         extra package reference. ReferenceOutputAssembly=false: never a runtime
         dependency, only a build-time analyzer. -->
    <ProjectReference Include="..\ElegantSeries.Flow.Generator\ElegantSeries.Flow.Generator.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer"
                      SetTargets="GetTargetPath" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pack the generator assembly under analyzers/: NuGet/MSBuild do not pack
         ProjectReference analyzers automatically, so list it explicitly
         (CommunityToolkit.Mvvm pattern). roslyn5.0 folder: the generator is built
         against Microsoft.CodeAnalysis 5.x (IIncrementalGenerator requires Roslyn 4.0+). -->
    <None Include="..\ElegantSeries.Flow.Generator\bin\$(Configuration)\netstandard2.0\ElegantSeries.Flow.Generator.dll"
          PackagePath="analyzers\dotnet\roslyn5.0\cs" Pack="true" Visible="false" />
  </ItemGroup>

</Project>
