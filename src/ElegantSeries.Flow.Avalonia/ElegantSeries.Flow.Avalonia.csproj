<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- NuGet package metadata (aligned with ElegantSeries.Flow.Core) -->
    <PackageId>ElegantSeries.Flow.Avalonia</PackageId>
    <Version>0.1.1</Version>
    <Authors>ligf</Authors>
    <Description>Avalonia UI adapter for ElegantSeries.Flow: a zero-reflection view locator, a typed BaseView, and a region NavigationHost that binds to INavigationService.</Description>
    <PackageTags>navigation;mvvm;avalonia;viewmodel;aot;trimming</PackageTags>
    <PackageProjectUrl>https://github.com/ligf/ElegantSeries.Flow</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ligf/ElegantSeries.Flow</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Documentation and symbols -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <!-- NU1902: known moderate vulnerability in Microsoft.Build.Tasks.Git, a build-time-only
         SourceLink dependency (PrivateAssets=All); it never ships to package consumers. -->
    <NoWarn>$(NoWarn);NU1902</NoWarn>
    <ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)' == ''">false</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- Local development only. When publishing, replace with:
         <PackageReference Include="ElegantSeries.Flow" Version="0.1.1" /> -->
    <ProjectReference Include="../ElegantSeries.Flow.Core/ElegantSeries.Flow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
