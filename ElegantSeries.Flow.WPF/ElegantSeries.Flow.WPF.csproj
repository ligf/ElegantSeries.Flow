<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- NuGet package metadata (aligned with the ElegantSeries.Flow core package) -->
    <PackageId>ElegantSeries.Flow.WPF</PackageId>
    <Version>0.1.0</Version>
    <Authors>ligf</Authors>
    <Description>WPF UI integration for the ElegantSeries.Flow MVVM navigation library: an AOT-friendly view locator, a typed BaseView base class, and a region-aware NavigationHost control.</Description>
    <PackageTags>navigation;mvvm;wpf;aot;trimming;viewmodel</PackageTags>
    <PackageProjectUrl>https://github.com/ligf/ElegantSeries.Flow</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ligf/ElegantSeries.Flow</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Documentation and symbols -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <!-- NU1902: known moderate vulnerability in Microsoft.Build.Tasks.Git, a build-time-only
         SourceLink dependency (PrivateAssets=All); it never ships to package consumers. -->
    <NoWarn>$(NoWarn);NU1902</NoWarn>
    <ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)' == ''">false</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Local development uses a project reference.
      Before publishing to NuGet, replace with:
        <PackageReference Include="ElegantSeries.Flow" Version="0.1.0" />
    -->
    <ProjectReference Include="../ElegantSeries.Flow.Core/ElegantSeries.Flow.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.102" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
