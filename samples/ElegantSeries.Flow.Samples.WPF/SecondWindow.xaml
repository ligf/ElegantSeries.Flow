<Window x:Class="ElegantSeries.Flow.Samples.WPF.SecondWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ElegantSeries.Flow.Samples.Shared;assembly=ElegantSeries.Flow.Samples.Shared"
        xmlns:flow="clr-namespace:ElegantSeries.Flow.WPF.Hosting;assembly=ElegantSeries.Flow.WPF"
        Title="Second Window (isolated navigation)" Height="300" Width="400">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Own INavigationService — stacks are isolated from the main window."
                   Margin="12,8" TextWrapping="Wrap" Opacity="0.7" />
        <flow:NavigationHost x:Name="WindowHost" RegionName="{x:Static vm:RegionNames.MainRegion}" Grid.Row="1" />
    </Grid>
</Window>
