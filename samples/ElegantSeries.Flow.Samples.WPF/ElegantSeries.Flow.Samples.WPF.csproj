<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ElegantSeries.Flow.Core\ElegantSeries.Flow.Core.csproj" />
    <ProjectReference Include="..\..\src\ElegantSeries.Flow.Mvvm\ElegantSeries.Flow.Mvvm.csproj" />
    <ProjectReference Include="..\..\src\ElegantSeries.Flow.WPF\ElegantSeries.Flow.WPF.csproj" />
    <ProjectReference Include="..\ElegantSeries.Flow.Samples.Shared\ElegantSeries.Flow.Samples.Shared.csproj" />
    <!-- [ViewFor] source generator: in-repo projects reference the generator directly.
         (Analyzers attached via ProjectReference do not flow transitively; external
         consumers instead get the generator from the ElegantSeries.Flow NuGet package,
         where it ships embedded under analyzers/ and flows via package dependencies.) -->
    <ProjectReference Include="..\..\src\ElegantSeries.Flow.Generator\ElegantSeries.Flow.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
