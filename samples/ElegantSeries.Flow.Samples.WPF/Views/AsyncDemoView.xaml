<flow:BaseView x:Class="ElegantSeries.Flow.Samples.WPF.Views.AsyncDemoView"
             x:TypeArguments="vm:AsyncDemoViewModel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:flow="clr-namespace:ElegantSeries.Flow.WPF.Views;assembly=ElegantSeries.Flow.WPF"
             xmlns:vm="clr-namespace:ElegantSeries.Flow.Samples.Shared;assembly=ElegantSeries.Flow.Samples.Shared"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AsyncDemoViewModel, IsDesignTimeCreatable=False}">
    <StackPanel Margin="24">
        <TextBlock Text="Async Lifecycle" FontSize="28" Margin="0,0,0,8" />
        <TextBlock Text="Navigate to another page and back — watch the async callbacks fire."
                   Margin="0,0,0,12" TextWrapping="Wrap" Opacity="0.6" />
        <TextBox Text="{Binding Log}" IsReadOnly="True" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" Height="200" FontFamily="Consolas" />
    </StackPanel>
</flow:BaseView>
