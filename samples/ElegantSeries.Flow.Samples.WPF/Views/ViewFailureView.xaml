<flow:BaseView x:Class="ElegantSeries.Flow.Samples.WPF.Views.ViewFailureView"
             x:TypeArguments="vm:ViewFailureViewModel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:flow="clr-namespace:ElegantSeries.Flow.WPF.Views;assembly=ElegantSeries.Flow.WPF"
             xmlns:vm="clr-namespace:ElegantSeries.Flow.Samples.Shared;assembly=ElegantSeries.Flow.Samples.Shared"
             xmlns:views="clr-namespace:ElegantSeries.Flow.Samples.WPF.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ViewFailureViewModel, IsDesignTimeCreatable=False}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="View Creation Failure" FontSize="28" Margin="0,0,0,8" />
            <TextBlock Text="The region below navigates to a ViewModel with no registered view. The host keeps the previous content and reports the failure through OnViewCreationFailed — shown here as a status line instead of crashing the UI."
                       TextWrapping="Wrap" Margin="0,0,0,12" Opacity="0.7" />
            <Button Content="Navigate to unregistered page" Command="{Binding NavigateToUnregisteredCommand}"
                    Width="240" HorizontalAlignment="Left" Margin="0,0,0,12" />
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,12">
            <views:FailureDemoHost x:Name="FailureHost" RegionName="{x:Static vm:RegionNames.FailureRegion}" />
        </Border>
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
    </Grid>
</flow:BaseView>
