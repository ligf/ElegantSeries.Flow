<flow:BaseView x:Class="ElegantSeries.Flow.Samples.WPF.Views.FeaturesView"
             x:TypeArguments="vm:FeaturesViewModel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:flow="clr-namespace:ElegantSeries.Flow.WPF.Views;assembly=ElegantSeries.Flow.WPF"
             xmlns:vm="clr-namespace:ElegantSeries.Flow.Samples.WPF.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FeaturesViewModel, IsDesignTimeCreatable=False}">
    <ScrollViewer Margin="24">
        <StackPanel>
            <TextBlock Text="Navigation Features" FontSize="28" Margin="0,0,0,4" />
            <TextBlock Text="This page implements INavigationAwareAsync — watch the log below."
                       Margin="0,0,0,16" Opacity="0.7" TextWrapping="Wrap" />

            <TextBlock Text="Modes" FontWeight="Bold" Margin="0,0,0,8" />
            <Button Content="Replace with Detail (Replace mode)" Command="{Binding ReplaceWithDetailCommand}"
                    Margin="0,0,0,8" HorizontalAlignment="Left" Width="280" />
            <Button Content="Clear stack back to Home (ClearStack mode)" Command="{Binding ClearStackToHomeCommand}"
                    Margin="0,0,0,8" HorizontalAlignment="Left" Width="280" />
            <Button Content="Refresh this page (refreshIfActive)" Command="{Binding RefreshSelfCommand}"
                    Margin="0,0,0,8" HorizontalAlignment="Left" Width="280" />
            <Button Content="Clear KeepAlive cache" Command="{Binding ClearKeepAliveCacheCommand}"
                    Margin="0,0,0,8" HorizontalAlignment="Left" Width="280" />
            <Button Content="Cancelled navigation demo" Command="{Binding CancelledNavigationCommand}"
                    Margin="0,0,0,8" HorizontalAlignment="Left" Width="280" />
            <TextBlock Text="{Binding CancelStatus}" Margin="0,0,0,16" Opacity="0.7" />

            <TextBlock Text="Lifecycle log (INavigationAwareAsync)" FontWeight="Bold" Margin="0,0,0,8" />
            <TextBox Text="{Binding Log}" IsReadOnly="True" AcceptsReturn="True"
                     Height="160" FontFamily="Consolas" />
        </StackPanel>
    </ScrollViewer>
</flow:BaseView>
