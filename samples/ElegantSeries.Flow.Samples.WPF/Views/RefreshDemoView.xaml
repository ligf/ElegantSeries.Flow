<flow:BaseView x:Class="ElegantSeries.Flow.Samples.WPF.Views.RefreshDemoView"
             x:TypeArguments="vm:RefreshDemoViewModel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:flow="clr-namespace:ElegantSeries.Flow.WPF.Views;assembly=ElegantSeries.Flow.WPF"
             xmlns:vm="clr-namespace:ElegantSeries.Flow.Samples.Shared;assembly=ElegantSeries.Flow.Samples.Shared"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RefreshDemoViewModel, IsDesignTimeCreatable=False}">
    <StackPanel Margin="16" VerticalAlignment="Center">
        <TextBlock Text="Refresh (refreshIfActive)" FontSize="20" Margin="0,0,0,8" />
        <TextBlock Text="{Binding InstanceId, StringFormat='Instance: {0}'}" Margin="0,0,0,4" Opacity="0.6" />
        <TextBlock Text="{Binding ActivationCount, StringFormat='Activations: {0}'}" Margin="0,0,0,12" />
        <Button Content="Refresh" Command="{Binding RefreshCommand}"
                Width="160" HorizontalAlignment="Left" />
        <TextBlock Text="Refresh re-runs activation on the same instance: the id stays, the count grows."
                   Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.6" />
    </StackPanel>
</flow:BaseView>
