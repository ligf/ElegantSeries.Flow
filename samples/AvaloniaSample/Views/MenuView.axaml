<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AvaloniaSample.ViewModels"
             x:Class="AvaloniaSample.Views.MenuView"
             x:DataType="vm:MenuViewModel">
    <StackPanel Margin="12">
        <TextBlock Text="Menu" FontSize="18" Margin="0,0,0,12" />
        <Button Content="Home" Command="{Binding GoHomeCommand}" Margin="0,0,0,8" />
        <Button Content="Detail" Command="{Binding GoDetailCommand}" Margin="0,0,0,8" />
        <Button Content="Counter (KeepAlive)" Command="{Binding GoCounterCommand}" />
    </StackPanel>
</UserControl>
