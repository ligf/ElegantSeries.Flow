<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AvaloniaSample.ViewModels"
             xmlns:host="clr-namespace:ElegantSeries.Flow.Avalonia.Hosting;assembly=ElegantSeries.Flow.Avalonia"
             x:Class="AvaloniaSample.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    <Grid RowDefinitions="Auto,*">
        <TextBlock x:Name="ErrorText" Foreground="DarkRed" Margin="4" />
        <Grid Grid.Row="1" RowDefinitions="*,*" ColumnDefinitions="*,*">
        <Border Grid.Row="0" Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="4">
            <host:NavigationHost x:Name="Q1Host" RegionName="Q1" />
        </Border>
        <Border Grid.Row="0" Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="4">
            <host:NavigationHost x:Name="Q2Host" RegionName="Q2" />
        </Border>
        <Border Grid.Row="1" Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="4">
            <host:NavigationHost x:Name="Q3Host" RegionName="Q3" />
        </Border>
        <Border Grid.Row="1" Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="4">
            <host:NavigationHost x:Name="Q4Host" RegionName="Q4" />
        </Border>
        </Grid>
    </Grid>
</UserControl>
