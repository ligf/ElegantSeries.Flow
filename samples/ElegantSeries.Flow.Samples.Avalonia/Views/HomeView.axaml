<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ElegantSeries.Flow.Samples.Shared;assembly=ElegantSeries.Flow.Samples.Shared"
             x:Class="ElegantSeries.Flow.Samples.Avalonia.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    <StackPanel Margin="24" VerticalAlignment="Center">
        <TextBlock Text="{Binding Title}" FontSize="28" Margin="0,0,0,8" />
        <TextBlock Text="{Binding InstanceId, StringFormat='Instance: {0}'}" Margin="0,0,0,4" Opacity="0.6" />
        <TextBlock Text="Navigate away and back — the id changes: the page was recreated."
                   Margin="0,0,0,16" TextWrapping="Wrap" Opacity="0.6" />
        <Button Content="Go to Detail" Command="{Binding GoToDetailCommand}"
                Width="160" HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
