<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ElegantSeries.Flow.Samples.Shared;assembly=ElegantSeries.Flow.Samples.Shared"
             x:Class="ElegantSeries.Flow.Samples.Avalonia.Views.DetailView"
             x:DataType="vm:DetailViewModel">
    <StackPanel Margin="24" VerticalAlignment="Center">
        <TextBlock Text="Detail" FontSize="28" Margin="0,0,0,8" />
        <TextBlock Text="{Binding Message}" Margin="0,0,0,16" />
        <Button Content="Go Back" Command="{Binding GoBackCommand}"
                Width="160" HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
