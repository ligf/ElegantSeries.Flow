<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ElegantSeries.Flow.Samples.Shared;assembly=ElegantSeries.Flow.Samples.Shared"
             x:Class="ElegantSeries.Flow.Samples.Avalonia.Views.ParamReceiverView"
             x:DataType="vm:ParamReceiverViewModel">
    <StackPanel Margin="16" VerticalAlignment="Center">
        <TextBlock Text="Received Parameter" FontSize="20" Margin="0,0,0,8" />
        <TextBlock Text="{Binding Message, StringFormat='Parameter: {0}'}" Margin="0,0,0,12" TextWrapping="Wrap" />
        <Button Content="Back" Command="{Binding GoBackCommand}"
                Width="140" HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
