<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ElegantSeries.Flow.Samples.Shared;assembly=ElegantSeries.Flow.Samples.Shared"
             x:Class="ElegantSeries.Flow.Samples.Avalonia.Views.ToolkitFreeView"
             x:DataType="vm:ToolkitFreeDemoViewModel">
    <StackPanel Margin="24">
        <TextBlock Text="Toolkit-Free ViewModel" FontSize="28" Margin="0,0,0,8" />
        <TextBlock Text="This page's ViewModel derives from NavigationViewModelBase (core package): manual SetProperty notification, no CommunityToolkit.Mvvm. The buttons call its public methods from code-behind."
                   Margin="0,0,0,12" TextWrapping="Wrap" Opacity="0.6" />
        <TextBlock Text="{Binding Count, StringFormat='Count: {0}'}" FontSize="20" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal">
            <Button Content="Increment" Click="OnIncrementClicked" Width="120" Margin="0,0,8,0" />
            <Button Content="Back" Click="OnBackClicked" Width="120" />
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="Red" Margin="0,8,0,0" />
    </StackPanel>
</UserControl>
