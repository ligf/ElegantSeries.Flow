<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ElegantSeries.Flow.Samples.Avalonia.ViewModels"
             x:Class="ElegantSeries.Flow.Samples.Avalonia.Views.ModesChildView"
             x:DataType="vm:ModesChildViewModel">
    <StackPanel Margin="16" VerticalAlignment="Center">
        <TextBlock Text="子页面" FontSize="20" Margin="0,0,0,12" />
        <Button Content="返回" Command="{Binding GoBackCommand}"
                Width="140" HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
