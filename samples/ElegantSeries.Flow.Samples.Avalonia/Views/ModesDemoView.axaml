<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ElegantSeries.Flow.Samples.Avalonia.ViewModels"
             x:Class="ElegantSeries.Flow.Samples.Avalonia.Views.ModesDemoView"
             x:DataType="vm:ModesDemoViewModel">
    <StackPanel Margin="16" VerticalAlignment="Center">
        <TextBlock Text="导航模式" FontSize="20" Margin="0,0,0,8" />
        <TextBlock Text="{Binding InstanceId, StringFormat='实例: {0}'}" Margin="0,0,0,4" />
        <TextBlock Text="{Binding ActivationCount, StringFormat='激活次数: {0}'}" Margin="0,0,0,12" />
        <Button Content="Push 子页" Command="{Binding PushChildCommand}"
                Width="140" HorizontalAlignment="Left" Margin="0,0,0,8" />
        <Button Content="Replace 为子页" Command="{Binding ReplaceWithChildCommand}"
                Width="140" HorizontalAlignment="Left" Margin="0,0,0,8" />
        <Button Content="ClearStack" Command="{Binding ClearStackCommand}"
                Width="140" HorizontalAlignment="Left" Margin="0,0,0,8" />
        <Button Content="Refresh" Command="{Binding RefreshCommand}"
                Width="140" HorizontalAlignment="Left" />
        <TextBlock Text="Refresh 复用同一实例(激活次数+1)；Replace/ClearStack 创建新实例。"
                   Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.6" />
    </StackPanel>
</UserControl>
