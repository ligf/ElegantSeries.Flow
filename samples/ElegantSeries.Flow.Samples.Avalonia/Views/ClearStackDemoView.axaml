<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ElegantSeries.Flow.Samples.Avalonia.ViewModels"
             x:Class="ElegantSeries.Flow.Samples.Avalonia.Views.ClearStackDemoView"
             x:DataType="vm:ClearStackDemoViewModel">
    <StackPanel Margin="16" VerticalAlignment="Center">
        <TextBlock Text="ClearStack Mode" FontSize="20" Margin="0,0,0,8" />
        <TextBlock Text="{Binding InstanceId, StringFormat='Instance: {0}'}" Margin="0,0,0,12" Opacity="0.6" />
        <Button Content="Push New Page" Command="{Binding PushSelfCommand}"
                Width="160" HorizontalAlignment="Left" Margin="0,0,0,8" />
        <Button Content="ClearStack" Command="{Binding ClearStackCommand}"
                Width="160" HorizontalAlignment="Left" Margin="0,0,0,8" />
        <Button Content="Back" Command="{Binding GoBackCommand}"
                Width="160" HorizontalAlignment="Left" />
        <TextBlock Text="Push a few pages, then ClearStack: the stack resets to one fresh page."
                   Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.6" />
    </StackPanel>
</UserControl>
