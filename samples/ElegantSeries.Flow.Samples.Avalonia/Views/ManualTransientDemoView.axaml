<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ElegantSeries.Flow.Samples.Shared;assembly=ElegantSeries.Flow.Samples.Shared"
             x:Class="ElegantSeries.Flow.Samples.Avalonia.Views.ManualTransientDemoView"
             x:DataType="vm:ManualTransientDemoViewModel">
    <StackPanel Margin="24">
        <TextBlock Text="Manual Registration (Transient)" FontSize="28" Margin="0,0,0,8" />
        <TextBlock Text="This view carries no [ViewFor] attribute. It is registered manually in App: views.RegisterTransient&lt;ManualTransientDemoView, ManualTransientDemoViewModel&gt;(), which registers the view mapping plus a transient ViewModel in DI."
                   Margin="0,0,0,12" TextWrapping="Wrap" Opacity="0.6" />
    </StackPanel>
</UserControl>
