<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:flow="clr-namespace:ElegantSeries.Flow.Avalonia.Hosting;assembly=ElegantSeries.Flow.Avalonia"
        x:Class="ElegantSeries.Flow.Samples.Avalonia.MainWindow"
        Title="ElegantSeries.Flow.Samples.Avalonia" Width="600" Height="400">
    <Grid RowDefinitions="Auto,*">
        <TextBlock x:Name="ErrorText" Foreground="DarkRed" Margin="4" />
        <Grid Grid.Row="1" ColumnDefinitions="180,*">
        <!-- Sidebar region: menu, navigates independently -->
        <flow:NavigationHost x:Name="SidebarHost" RegionName="Sidebar" Grid.Column="0" />
        <!-- Four quadrant regions: each navigates independently.
             The menu drives Q1; the other quadrants keep their own content. -->
        <Grid Grid.Column="1" RowDefinitions="*,*" ColumnDefinitions="*,*">
            <Border Grid.Row="0" Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="4">
                <flow:NavigationHost x:Name="Q1Host" RegionName="Q1" />
            </Border>
            <Border Grid.Row="0" Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="4">
                <flow:NavigationHost x:Name="Q2Host" RegionName="Q2" />
            </Border>
            <Border Grid.Row="1" Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="4">
                <flow:NavigationHost x:Name="Q3Host" RegionName="Q3" />
            </Border>
            <Border Grid.Row="1" Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="4">
                <flow:NavigationHost x:Name="Q4Host" RegionName="Q4" />
            </Border>
        </Grid>
        </Grid>
    </Grid>
</Window>
