<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:flow="clr-namespace:ElegantSeries.Flow.Avalonia.Hosting;assembly=ElegantSeries.Flow.Avalonia"
        x:Class="ElegantSeries.Flow.Samples.Avalonia.SecondWindow"
        Title="Second Window (isolated navigation)" Width="400" Height="300">
    <Grid RowDefinitions="Auto,Auto,*">
        <TextBlock Text="Own INavigationService — stacks are isolated from the main window."
                   Margin="12,8" TextWrapping="Wrap" Opacity="0.7" />
        <TextBlock x:Name="ErrorText" Foreground="DarkRed" Margin="12,0" />
        <flow:NavigationHost x:Name="WindowHost" RegionName="MainRegion" Grid.Row="2" />
    </Grid>
</Window>
