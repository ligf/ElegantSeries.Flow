<flow:BaseView x:Class="WpfSample.Views.DetailView"
             x:TypeArguments="vm:DetailViewModel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:flow="clr-namespace:ElegantSeries.Flow.WPF.Views;assembly=ElegantSeries.Flow.WPF"
             xmlns:vm="clr-namespace:WpfSample.ViewModels">
    <StackPanel Margin="24" VerticalAlignment="Center">
        <TextBlock Text="Detail" FontSize="28" Margin="0,0,0,8" />
        <TextBlock Text="{Binding Message}" Margin="0,0,0,16" />
        <Button Content="Go Back" Command="{Binding GoBackCommand}"
                Width="160" HorizontalAlignment="Left" />
    </StackPanel>
</flow:BaseView>
