<flow:BaseView x:Class="WpfSample.Views.MenuView"
             x:TypeArguments="vm:MenuViewModel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:flow="clr-namespace:ElegantSeries.Flow.WPF.Views;assembly=ElegantSeries.Flow.WPF"
             xmlns:vm="clr-namespace:WpfSample.ViewModels">
    <StackPanel Margin="12">
        <TextBlock Text="Menu" FontSize="18" Margin="0,0,0,12" />
        <Button Content="Home" Command="{Binding GoHomeCommand}" Margin="0,0,0,8" />
        <Button Content="Detail" Command="{Binding GoDetailCommand}" Margin="0,0,0,8" />
        <Button Content="Counter (KeepAlive)" Command="{Binding GoCounterCommand}" />
    </StackPanel>
</flow:BaseView>
